# ---- Database ----
POSTGRES_USER=drumscribe
POSTGRES_PASSWORD=drumscribe
POSTGRES_DB=drumscribe
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
MAX_CONCURRENT_JOBS_PER_USER=3
ARTIFACT_TTL_HOURS=24

# ---- Task Queue ----
# Set to "false" for MVP mode (runs pipeline in-process, no Redis/Celery)
# Set to "true" for production mode (distributed workers with Celery)
USE_CELERY=false

# ---- Model Management ----
# AST model is pulled dynamically from HuggingFace (MIT/ast-finetuned-audioset-10-10-0.4593)
# BS-Roformer model is pulled via audio-separator package
# No manual model management required - models are cached automatically

# ---- Modal Serverless GPU (Optional Cloud Deployment) ----
# Set USE_MODAL=true to offload GPU inference to Modal's serverless infrastructure
# Benefits: Scale-to-zero, pay-per-inference, no GPU management
# Cost: ~$0.02-$0.04 per track (vs. $432/month for always-on GPU)
USE_MODAL=false
MODAL_APP_NAME=drumscribe-ml
MODAL_FUNCTION_NAME=process_audio_pipeline

# ---- Storage Backend ----
# "local" for dev (shared Docker volume), "s3" for production (PaaS-compatible)
STORAGE_BACKEND=local
# S3 settings (only used when STORAGE_BACKEND=s3)
# S3_BUCKET=drumscribe-artifacts
# S3_PREFIX=artifacts
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=  # For Cloudflare R2: https://<account>.r2.cloudflarestorage.com

# ---- PDF Export ----
# "lilypond" (headless, recommended), "musescore" (needs xvfb), or "none"
PDF_BACKEND=lilypond

# ---- Frontend ----
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
