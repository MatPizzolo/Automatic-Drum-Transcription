# syntax=docker/dockerfile:1
# Celery worker image — full local stack or self-hosted production.
# Runs drum separation (BS-Roformer via audio-separator) and
# hit detection (AST via transformers) as Celery tasks.

# ---- build stage ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf AS builder

# gcc/g++         — C/C++ extensions (numpy, soundfile, psutil)
# libpq-dev       — psycopg2-binary headers
# libsndfile1-dev — soundfile native extension
# libffi-dev      — cffi / cryptography wheels
# cmake           — required by some torch sub-dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev libsndfile1-dev libffi-dev cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements-api.txt requirements-worker.txt ./

# Install CPU-only torch/torchaudio first to avoid pulling the full NVIDIA
# CUDA stack (~2-4 GB) that pip selects by default on linux/arm64.
# pip sees torch already satisfied when it processes requirements-worker.txt.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.0.0,<3.0.0" "torchaudio>=2.0.0" && \
    pip install -r requirements-worker.txt

# ---- runtime stage ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf

LABEL org.opencontainers.image.title="drumscribe-worker" \
      org.opencontainers.image.description="DrumScribe Celery worker: drum separation (BS-Roformer) + hit detection (AST)" \
      org.opencontainers.image.version="0.1.0"

# libpq5      — asyncpg / psycopg2 runtime
# libsndfile1 — soundfile audio I/O
# ffmpeg      — audio decoding (librosa / torchaudio)
# lilypond    — PDF sheet music export
# curl        — healthcheck probe
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libsndfile1 ffmpeg lilypond curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN useradd -r -m -s /usr/sbin/nologin -u 1001 appuser
WORKDIR /app
COPY --chown=appuser:appuser . .

RUN mkdir -p /data/artifacts /data/models /tmp/celery \
    && chown -R appuser:appuser /data /tmp/celery \
    && chmod +x /app/scripts/entrypoint-worker.sh /app/scripts/download_models.sh

USER appuser

ENV MPLCONFIGDIR=/tmp/matplotlib \
    NUMBA_CACHE_DIR=/tmp/numba_cache

# Allow Celery to shut down gracefully before Docker kills the container.
STOPSIGNAL SIGTERM

# Longer start period: worker preloads ML models before serving tasks.
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD celery -A app.worker inspect ping --timeout=5 || exit 1

ENTRYPOINT ["/app/scripts/entrypoint-worker.sh"]
CMD ["celery", "-A", "app.worker", "worker", "--loglevel=info"]
