# syntax=docker/dockerfile:1

# ---- build stage: install deps with build tools ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf AS builder

# Build tools for compiled extensions:
#   gcc/g++         — C/C++ extensions (numpy, soundfile, psutil)
#   libpq-dev       — psycopg2 headers
#   libsndfile1-dev — soundfile wheel
#   libffi-dev      — cffi/cryptography wheels
#   cmake           — some torch sub-deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev libsndfile1-dev libffi-dev cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements-api.txt requirements-worker.txt ./

# ── Tier 0 ───────────────────────────────────────────────────────────────
# Upgrade installer chain for PEP 517/518 support.
# Install to system site-packages (NO --prefix) so every subsequent pip
# invocation in this stage sees the same resolved environment.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel

# ── Tier 1 ───────────────────────────────────────────────────────────────
# Pre-install build-time deps that madmom's setup.py imports at *metadata*
# collection time (before pip starts the actual build).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "Cython>=3.0.0,<4" "numpy==1.26.4"

# ── Tier 2 ───────────────────────────────────────────────────────────────
# Install ALL non-madmom requirements with full build isolation (default).
# This guarantees pip resolves the complete transitive dep tree, including
# packaging (required by kombu/celery[redis]).
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v '^madmom' requirements-worker.txt > req-no-madmom.txt && \
    pip install -r req-no-madmom.txt

# ── Tier 3 ───────────────────────────────────────────────────────────────
# Install madmom alone with --no-build-isolation so its legacy setup.py
# can import numpy + Cython already present from Tier 1.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-build-isolation "madmom==0.16.1"

# ---- runtime stage: slim image with audio/PDF tooling ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf

LABEL org.opencontainers.image.title="drumscribe-api-mvp" \
      org.opencontainers.image.description="DrumScribe FastAPI backend with embedded ML pipeline (MVP mode)" \
      org.opencontainers.image.version="0.1.0"

# Runtime shared libs: libpq5 (asyncpg), libsndfile1 (soundfile), ffmpeg (demucs/librosa),
# lilypond (PDF export), curl (healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 ffmpeg libsndfile1 curl lilypond \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder's system Python.
# We installed directly to system site-packages (no --prefix) so we copy
# those paths explicitly — this is correct and complete with no prefix merge.
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN useradd -r -m -s /usr/sbin/nologin -u 1001 appuser
WORKDIR /app
COPY --chown=appuser:appuser . .

RUN mkdir -p /data/artifacts /data/models /tmp/matplotlib \
    && chown -R appuser:appuser /data /tmp/matplotlib

RUN chmod +x /app/scripts/entrypoint-api.sh

USER appuser

# Set matplotlib config directory to writable location to avoid warnings
ENV MPLCONFIGDIR=/tmp/matplotlib

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

ENTRYPOINT ["/app/scripts/entrypoint-api.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
