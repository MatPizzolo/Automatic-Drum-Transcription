# syntax=docker/dockerfile:1
# MVP all-in-one image — local development only.
# Runs FastAPI + full ML pipeline in a single process (USE_CELERY=false).
# No Celery or Redis required.

# ---- build stage ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf AS builder

# gcc/g++         — C/C++ extensions (numpy, soundfile, psutil)
# libpq-dev       — psycopg2-binary headers
# libsndfile1-dev — soundfile native extension
# libffi-dev      — cffi / cryptography wheels
# cmake           — required by some torch sub-dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev libsndfile1-dev libffi-dev cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements-api.txt requirements-worker.txt ./

# Install CPU-only torch/torchaudio first to avoid pulling the full NVIDIA
# CUDA stack (~2-4 GB) that pip selects by default on linux/arm64.
# pip sees torch already satisfied when it processes requirements-worker.txt.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.0.0,<3.0.0" "torchaudio>=2.0.0" && \
    pip install -r requirements-worker.txt

# ---- runtime stage ----
FROM python:3.11-slim@sha256:0b23cfb7425d065008b778022a17b1551c82f8b4866ee5a7a200084b7e2eafbf

LABEL org.opencontainers.image.title="drumscribe-mvp" \
      org.opencontainers.image.description="DrumScribe all-in-one: FastAPI + ML pipeline in-process (USE_CELERY=false)" \
      org.opencontainers.image.version="0.1.0"

# libpq5      — asyncpg / psycopg2 runtime
# libsndfile1 — soundfile audio I/O
# ffmpeg      — audio decoding (librosa / torchaudio)
# lilypond    — PDF sheet music export
# curl        — Docker healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libsndfile1 ffmpeg lilypond curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

RUN useradd -r -m -s /usr/sbin/nologin -u 1001 appuser
WORKDIR /app
COPY --chown=appuser:appuser . .

RUN mkdir -p /data/artifacts /data/models /tmp/matplotlib \
    && chown -R appuser:appuser /data /tmp/matplotlib \
    && chmod +x /app/scripts/entrypoint-api.sh

USER appuser

ENV USE_CELERY=false \
    MPLCONFIGDIR=/tmp/matplotlib \
    NUMBA_CACHE_DIR=/tmp/numba_cache

EXPOSE 8000

# Longer start period: first run downloads ML models at startup.
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8000/api/health || exit 1

ENTRYPOINT ["/app/scripts/entrypoint-api.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
